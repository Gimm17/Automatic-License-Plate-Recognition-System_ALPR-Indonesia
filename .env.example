# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=alpr_db
DB_USER=root
DB_PASSWORD=
DB_FALLBACK_SQLITE=true

# App
APP_ENV=development
APP_DEBUG=true
API_SECRET_KEY=change-this-to-a-long-random-secret-key
API_REQUIRE_KEY=false
API_KEY=change-this-demo-api-key
ENABLE_DETECTION_WORKER=false

# CORS — comma separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://yourdomain.com

# ML Models
YOLO_MODEL_PATH=ml_models/yolov8n_plate.pt
YOLO_CONFIDENCE=0.45
OCR_LANGUAGE=en

# Storage
STORAGE_PATH=storage
MAX_UPLOAD_SIZE_MB=50
TEMP_FILE_TTL_HOURS=24

# Stream
DEFAULT_STREAM_FPS=5
PROCESS_EVERY_N_FRAMES=5
STREAM_JPEG_QUALITY=60

# Frontend (Vite)
VITE_API_BASE_URL=
VITE_WS_BASE_URL=ws://localhost:8000
VITE_API_KEY=

# Production notes:
# - Set APP_ENV=production and APP_DEBUG=false.
# - Set API_REQUIRE_KEY=true and API_KEY to a long random value for private demos.
# - Set DB_FALLBACK_SQLITE=false unless you explicitly accept SQLite fallback.
# - Keep ENABLE_DETECTION_WORKER=false on free/shared hosting unless resources are sized for it.
